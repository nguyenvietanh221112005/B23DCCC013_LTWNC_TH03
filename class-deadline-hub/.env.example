# Tạo bằng: npx auth secret  (hoặc openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# URL công khai, dùng cho sitemap, canonical, JSON-LD, ảnh OG
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# (Tuỳ chọn) GitHub OAuth — callback: <SITE_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
